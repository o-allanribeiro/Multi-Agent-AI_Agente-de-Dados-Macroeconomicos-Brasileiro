# Arquivos de variáveis de ambiente - NUNCA ENVIE PARA O GIT!
# Contêm senhas, chaves de API e outras informações sensíveis.
.env
.env.*
!.env.example

# Ambientes virtuais
venv/
.venv/
env/
virtualenv/

# Cache e arquivos compilados do Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Pastas de distribuição e build
build/
dist/
*.egg-info/
*.egg

# Arquivos e pastas de IDEs e editores de código
.vscode/
.idea/
*.swp

# Arquivos de testes e cobertura de código
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Arquivos de sistema operacional
.DS_Store
Thumbs.db

# Banco de dados local gerado em desenvolvimento
*.db
*.sqlite3

# Cache de séries temporais (gerado pelo SeriesCache — regenerável)
output/series_cache.db

# Gráficos e artefatos gerados pelo agente
output/
src/output/
!output/.gitkeep

# Relatórios de cobertura de testes
htmlcov/
.coverage
coverage.xml

# mypy
.mypy_cache/
*.pyi.cache

# DynamoDB Local (binários e metadados — baixar separadamente, não versionar)
dynamodb_local_latest/
*.jar
DynamoDBLocal_lib/
dynamodb-local-metadata.json

# Logs da aplicação
*.log
api.log
api_err.log

# Terraform / IaC (estado local — NUNCA commitar)
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Docker volumes locais
docker-volumes/

# Chaves e certificados
*.pem
*.key
*.crt
*.p12

# mypy
.mypy_cache/
*.pyi.cache

# Logs locais
*.log
logs/

# Artefatos de build e distribuição
build/
dist/
*.egg-info/

# Pasta de scripts temporários
scratch/
tmp/