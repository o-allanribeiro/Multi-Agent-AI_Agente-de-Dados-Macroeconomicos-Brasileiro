# =============================================================================
# ARQUIVO DE EXEMPLO — VARIÁVEIS DE AMBIENTE
# Projeto: Agente Macro-BR
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este arquivo:  copy .env.example .env
#   2. Preencha os valores obrigatórios marcados com (OBRIGATÓRIO)
#   3. NUNCA adicione o arquivo .env ao controle de versão (já no .gitignore)
#   4. Para homologação/produção na nuvem, use AWS Secrets Manager ou
#      variáveis de ambiente do container (ECS Task Definition / docker-compose).
#
# AMBIENTES:
#   development  → local, SQLite, DynamoDB Local opção
#   staging      → nuvem (AWS), DynamoDB real, Gemini via Secret Manager
#   production   → nuvem (AWS), todas as proteções ativadas
#
# =============================================================================


# =============================================================================
# BLOCO 1 — OBRIGATÓRIO (todos os ambientes)
# =============================================================================

# Chave da API Google AI Studio (OBRIGATÓRIO)
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="sua_chave_aqui"

# Ambiente de execução
# Opções: development | staging | production
APP_ENV="development"


# =============================================================================
# BLOCO 2 — SERVIDOR E LOGGING
# =============================================================================

# Logging
# Opções: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="DEBUG"
# Opções: json (produção/CloudWatch) | text (desenvolvimento)
LOG_FORMAT="text"

# Servidor FastAPI
API_HOST="0.0.0.0"
API_PORT=8000

# CORS: origens permitidas (separadas por vírgula).
# O padrão já é só localhost; "*" libera qualquer site e só deve ser usado de propósito.
# Em produção, liste os domínios exatos:
# CORS_ORIGINS="https://app.orgao.gov.br,https://dashboard.orgao.gov.br"
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Chave das rotas administrativas (POST /admin/refresh), enviada no header X-API-Key.
# Em produção, sem ela a rota fica desabilitada. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=""


# =============================================================================
# BLOCO 3 — STORAGE (escolha UM backend)
# =============================================================================

# --- Opção A: SQLite (desenvolvimento local, sem configuração adicional) ---
STORAGE_BACKEND="sqlite"
DATABASE_URL="sqlite:///./agente_macro.db"

# --- Opção B: DynamoDB Local (teste de integração sem AWS) ---
# Pré-requisito: executar scripts/start_dynamodb_local.ps1
#                depois: python scripts/setup_dynamodb_local.py
# STORAGE_BACKEND="dynamodb"
# DYNAMODB_ENDPOINT_URL="http://localhost:8001"
# AWS_REGION="us-east-1"
# DYNAMODB_TABLE_NAME="agente-macro-conversations"
# (Credenciais fake são inseridas automaticamente pelo DynamoDBBackend)

# --- Opção C: DynamoDB AWS Real (staging / produção) ---
# STORAGE_BACKEND="dynamodb"
# AWS_REGION="us-east-1"
# DYNAMODB_TABLE_NAME="agente-macro-conversations-prod"
# (Credenciais via IAM Role ou variáveis abaixo)


# =============================================================================
# BLOCO 4 — LLM (Google Gemini)
# =============================================================================

LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE=0.2


# =============================================================================
# BLOCO 4B — FONTES DE DADOS OPCIONAIS
# =============================================================================

# Chave da API do FRED / Federal Reserve Bank of St. Louis (OPCIONAL)
# Habilita a ferramenta get_fred_series (T-Bill 3m e Treasuries 1, 2, 5 e 10 anos).
# Sem a chave, a ferramenta fica desativada e o restante do agente funciona normalmente.
# Chave gratuita em: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""


# =============================================================================
# BLOCO 5 — DIRETÓRIOS DE SAÍDA
# =============================================================================

# Gráficos gerados pelo agente
AGENT_OUTPUT_DIR="output"


# =============================================================================
# BLOCO 6 — AWS (staging / produção na nuvem)
# =============================================================================
# Em EC S Fargate com IAM Role, NÃO defina AWS_ACCESS_KEY_ID aqui.
# Use apenas quando rodar fora de ambiente AWS (ex: máquina local vs AWS real).
#
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
# AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
# AWS_SESSION_TOKEN="token_temporario_se_usar_iam_role_ou_sso"


# =============================================================================
# BLOCO 7 — RATE LIMITING
# =============================================================================

# Limite padrão do endpoint /ask (ex: "10/minute", "100/hour")
# Configurado em src/api/routes.py — esta variável é apenas referência.
# RATE_LIMIT_ASK="10/minute"

# DynamoDB (armazenamento de conversas em produção):
# STORAGE_BACKEND="dynamodb"
# DYNAMODB_TABLE_NAME="agente-macro-conversations"
# DYNAMODB_ENDPOINT_URL=""  # Deixe vazio para AWS real; "http://localhost:8001" para DynamoDB Local

# S3 (armazenamento de gráficos em produção):
# S3_BUCKET_NAME="agente-macro-assets"
# S3_PLOTS_PREFIX="plots/"

# CloudWatch (logs em produção):
# CLOUDWATCH_LOG_GROUP="/ecs/agente-macro"
