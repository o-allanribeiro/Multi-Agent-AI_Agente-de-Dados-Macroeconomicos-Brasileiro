# =============================================================================
# ARQUIVO DE EXEMPLO — VARIÁVEIS DE AMBIENTE
# Projeto: Agente Macro-BR
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este arquivo:  copy .env.example .env
#   2. Preencha os valores  obrigatórios marcados com (OBRIGATÓRIO)
#   3. NUNCA adicione o arquivo .env ao controle de versão (já está no .gitignore)
#
# =============================================================================

# --- OBRIGATÓRIO: Chave da API Google AI Studio ---
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="sua_chave_aqui"

# --- Ambiente de execução ---
# Opções: development | production | testing
APP_ENV="development"

# --- Logging ---
# Opções: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="DEBUG"
# Opções: json (produção/CloudWatch) | text (desenvolvimento)
LOG_FORMAT="text"

# --- Servidor API ---
API_HOST="0.0.0.0"
API_PORT=8000

# --- CORS: origens permitidas (separadas por vírgula) ---
# Em development, use "*" para permitir tudo
# Em produção, liste os domínios exatos: "https://app.orgao.gov.br,https://dashboard.orgao.gov.br"
CORS_ORIGINS="*"

# --- Banco de Dados ---
# SQLite (desenvolvimento local — sem configuração adicional):
DATABASE_URL="sqlite:///./agente_macro.db"
STORAGE_BACKEND="sqlite"

# PostgreSQL (produção on-premises):
# DATABASE_URL="postgresql://user:password@localhost:5432/agente_macro"
# STORAGE_BACKEND="postgres"

# --- LLM (Google Gemini) ---
LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE=0.2

# --- Diretório de saída para gráficos (desenvolvimento) ---
AGENT_OUTPUT_DIR="output"

# =============================================================================
# AWS — Preencher apenas para deploy na nuvem
# =============================================================================

# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="sua_access_key"
# AWS_SECRET_ACCESS_KEY="sua_secret_key"
# AWS_SESSION_TOKEN="token_temporario_se_usar_iam_role"

# DynamoDB (armazenamento de conversas em produção):
# STORAGE_BACKEND="dynamodb"
# DYNAMODB_TABLE_NAME="agente-macro-conversations"
# DYNAMODB_ENDPOINT_URL=""  # Deixe vazio para AWS real; "http://localhost:8001" para DynamoDB Local

# S3 (armazenamento de gráficos em produção):
# S3_BUCKET_NAME="agente-macro-assets"
# S3_PLOTS_PREFIX="plots/"

# CloudWatch (logs em produção):
# CLOUDWATCH_LOG_GROUP="/ecs/agente-macro"
